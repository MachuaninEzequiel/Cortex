{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cortex Brain",
  "version": "0.1.0",
  "identifier": "com.cortex.brain",
  "build": {
    "frontendDist": "../../../apps/brain-ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm --prefix ../../apps/brain-ui run dev",
    "beforeBuildCommand": "npm --prefix ../../apps/brain-ui run build"
  },
  "app": {
    "windows": [
      {
        "title": "Cortex Brain",
        "width": 1100,
        "height": 720,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: https://huggingface.co; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
